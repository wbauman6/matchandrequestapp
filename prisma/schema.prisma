// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

// Note that some adapters may set a maximum length for the String type by default, please ensure your strings are long
// enough when changing adapters.
// See https://www.prisma.io/docs/orm/reference/prisma-schema-reference#string for more information
datasource db {
  provider  = "postgresql"
  url       = env("POSTGRES_PRISMA_URL")
  directUrl = env("POSTGRES_URL_NON_POOLING")
}

enum Priority {
  normal
  urgent
}

enum Status {
  active
  pending
  in_review
  fulfilled
  archived
}

model Request {
  id               String   @id @default(cuid())
  shop             String
  customerName     String
  customerEmail    String?
  salespersonName  String
  salespersonEmail String
  description      String?
  keywords         String[]
  budget           Float?
  customerId       String?
  priority         Priority @default(normal)
  status           Status   @default(active)
  pinned           Boolean  @default(false)
  lastReminderAt   DateTime?
  // Typed facets derived from keywords at creation (item_type, brand, motif,
  // gemstone, material, etc.) — see app/lib/facets.js. Stored for inspection
  // and to enable item_type-indexed candidate lookup.
  facets           Json?
  itemType         String?
  embedding        Json?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  matches          Match[]
  notes            Note[]

  @@index([shop])
  @@index([shop, itemType])
}

model Match {
  id              String   @id @default(cuid())
  shop            String
  requestId       String
  productId       String
  productTitle    String
  productPrice    Float?
  productImage    String?
  score           Float
  matchedKeywords String[]
  read            Boolean  @default(false)
  declined        Boolean  @default(false)
  // Review queue: borderline matches are flagged for staff confirm/dismiss.
  needsReview     Boolean  @default(false)
  reasoning       String?
  confirmedAt     DateTime?
  createdAt       DateTime @default(now())
  request         Request  @relation(fields: [requestId], references: [id], onDelete: Cascade)

  @@unique([requestId, productId])
  @@index([shop])
  @@index([requestId])
  @@index([shop, needsReview])
}

model Note {
  id          String   @id @default(cuid())
  shop        String
  requestId   String
  authorName  String
  body        String
  notifyStaff Boolean  @default(false)
  createdAt   DateTime @default(now())
  request     Request  @relation(fields: [requestId], references: [id], onDelete: Cascade)

  @@index([requestId])
  @@index([shop])
}

model Salesperson {
  id        String   @id @default(cuid())
  shop      String
  name      String
  email     String
  active    Boolean  @default(true)
  createdAt DateTime @default(now())

  @@unique([shop, email])
  @@index([shop])
}

model ProductEmbedding {
  id        String   @id @default(cuid())
  shop      String
  productId String   @unique
  hash      String
  embedding Json
  title     String?
  price     Float?
  image     String?
  updatedAt DateTime @updatedAt

  @@index([shop])
}

model ShopConfig {
  id              String   @id @default(cuid())
  shop            String   @unique
  // Matches scoring >= autoNotifyScore notify the salesperson directly.
  // Matches scoring >= reviewScore but < autoNotifyScore go to the review queue.
  // Below reviewScore are dropped.
  autoNotifyScore Int      @default(50)
  reviewScore     Int      @default(40)
  // When enabled, borderline (review-band) matches are additionally judged by a
  // single structured LLM call before being queued/notified.
  stage2Enabled   Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model Session {
  id            String    @id
  shop          String
  state         String
  isOnline      Boolean   @default(false)
  scope         String?
  expires       DateTime?
  accessToken   String
  userId        BigInt?
  firstName     String?
  lastName      String?
  email         String?
  accountOwner  Boolean   @default(false)
  locale        String?
  collaborator  Boolean?  @default(false)
  emailVerified Boolean?  @default(false)
  refreshToken        String?
  refreshTokenExpires DateTime?
}
