// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

// Note that some adapters may set a maximum length for the String type by default, please ensure your strings are long
// enough when changing adapters.
// See https://www.prisma.io/docs/orm/reference/prisma-schema-reference#string for more information
datasource db {
  provider  = "postgresql"
  url       = env("POSTGRES_PRISMA_URL")
  directUrl = env("POSTGRES_URL_NON_POOLING")
}

enum Priority {
  normal
  urgent
}

enum Status {
  active
  pending
  in_review
  fulfilled
  archived
}

model Request {
  id               String   @id @default(cuid())
  shop             String
  customerName     String
  customerEmail    String?
  // Callback number. Required for storefront (customer-submitted) requests —
  // the assigned salesperson phones the customer. Optional for staff-created.
  customerPhone    String?
  // Where the request came from:
  //   "staff"    — created in the admin app or the POS extension by a salesperson
  //   "customer" — submitted by a shopper on the storefront form (app proxy).
  // Customer-submitted requests are round-robin assigned and flagged in POS and
  // the admin app so the salesperson knows to phone the customer. The CUSTOMER
  // never sees matches — results are staff-only. See app/routes/proxy.requests.jsx.
  source           String   @default("staff")
  salespersonName  String
  salespersonEmail String
  description      String?
  // Free-text refinements a salesperson adds AFTER creation to narrow, broaden,
  // or nudge matching (e.g. "must be pear-shaped", "any yellow tone is fine",
  // "prefers vintage"). Folded into the SAME request picture as the description
  // for embedding + reasoning; saving it re-runs matching. See runMatchesForRequest.
  matchNotes       String?
  keywords         String[]
  budget           Float?
  customerId       String?
  priority         Priority @default(normal)
  status           Status   @default(active)
  pinned           Boolean  @default(false)
  lastReminderAt   DateTime?
  // Typed facets derived from keywords at creation (item_type, brand, motif,
  // gemstone, material, etc.) — see app/lib/facets.js. Stored for inspection
  // and to enable item_type-indexed candidate lookup.
  facets           Json?
  itemType         String?
  embedding        Json?
  // Matching lifecycle so a transient AI/matching failure is distinguishable
  // from a genuine "nothing in stock" result:
  //   "pending" — background match hasn't finished yet
  //   "ok"      — match completed (0 matches here is a real "watching" state)
  //   "error"   — the reasoning/matching pass failed and should be retried
  //   null      — legacy request created before this field (treat as "ok")
  matchState       String?
  matchError       String?
  matchedAt        DateTime?
  // Digest throttle: last time this request was emailed about new matches.
  // Keep-watching sends at most one digest per request per EMAIL_MIN_INTERVAL.
  lastMatchEmailAt DateTime?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  matches          Match[]
  notes            Note[]

  @@index([shop])
  @@index([shop, itemType])
  @@index([shop, source, createdAt])
}

model Match {
  id              String   @id @default(cuid())
  shop            String
  requestId       String
  productId       String
  productTitle    String
  productPrice    Float?
  productImage    String?
  score           Float
  matchedKeywords String[]
  read            Boolean  @default(false)
  declined        Boolean  @default(false)
  // Review queue: borderline matches are flagged for staff confirm/dismiss.
  needsReview     Boolean  @default(false)
  reasoning       String?
  confidence      String?
  overBudget      Boolean  @default(false)
  // Send-record: set when this match was included in an alert/digest email.
  // A match is emailed AT MOST once, ever (fixes the duplicate-email storm).
  notifiedAt      DateTime?
  confirmedAt     DateTime?
  createdAt       DateTime @default(now())
  request         Request  @relation(fields: [requestId], references: [id], onDelete: Cascade)

  @@unique([requestId, productId])
  @@index([shop])
  @@index([requestId])
  @@index([shop, needsReview])
}

model Note {
  id          String   @id @default(cuid())
  shop        String
  requestId   String
  authorName  String
  body        String
  notifyStaff Boolean  @default(false)
  createdAt   DateTime @default(now())
  request     Request  @relation(fields: [requestId], references: [id], onDelete: Cascade)

  @@index([requestId])
  @@index([shop])
}

model Salesperson {
  id        String   @id @default(cuid())
  shop      String
  name      String
  email     String
  // "admin" sees all requests/matches on POS; "salesperson" sees only their own.
  role      String   @default("salesperson")
  // Numeric Shopify POS staff-member ID (from the POS Session API), stored as a
  // string. Used to map the pinned iPad staff member to this salesperson, since
  // the POS Session API exposes staffMemberId but not email. Set once via Settings.
  posStaffId String?
  active    Boolean  @default(true)
  // Opt-in to the round-robin rotation for CUSTOMER-SUBMITTED (storefront)
  // requests. Defaults on for new salespeople; the admin app turns it off for
  // admins on create and it is toggleable per person in Settings. Only active
  // people with this flag receive storefront requests. See app/lib/rotation.server.js.
  inRotation Boolean @default(true)
  // Last time the rotation handed this person a customer-submitted request.
  // Display/diagnostics only — fairness comes from RotationState.cursor.
  lastAssignedAt DateTime?
  createdAt DateTime @default(now())

  @@unique([shop, email])
  @@index([shop])
  @@index([shop, posStaffId])
  @@index([shop, inRotation, active])
}

// Round-robin cursor for assigning customer-submitted requests, one row per
// shop. `cursor` is a monotonically increasing counter incremented atomically
// (INSERT … ON CONFLICT … RETURNING) so two simultaneous storefront submissions
// can never take the same slot; the assignee is candidates[(cursor - 1) % n]
// over a deterministically ordered candidate list.
model RotationState {
  shop      String   @id
  cursor    Int      @default(0)
  updatedAt DateTime @default(now()) @updatedAt
}

// Records that a (request, product-version) pair was already reasoned about, so
// the keep-watching webhook never re-runs the AI on an unchanged product —
// including pairs the AI rejected (which create no Match row to dedupe on).
model MatchEval {
  id          String   @id @default(cuid())
  shop        String
  requestId   String
  productId   String
  productHash String
  matched     Boolean
  // "ok"    — the pair was fully evaluated (a zero-match request whose pairs are
  //           all "ok" is provably "evaluated, nothing qualified").
  // "error" — evaluation was attempted but errored; retried next run (dedupe
  //           skips only "ok" pairs, so errored pairs are re-evaluated).
  status      String   @default("ok")
  error       String?
  updatedAt   DateTime @default(now()) @updatedAt
  createdAt   DateTime @default(now())

  @@unique([requestId, productId])
  @@index([shop, productId])
  @@index([shop, status])
}

// Audit record for one weekly-drop run (Tuesday 4 PM ET). Proves what was
// detected, embedded, evaluated, and matched — and lists every failure — so a
// zero-match outcome is never confused with a silent failure. Surfaced in the
// admin app and emailed on failure. `coverageThrough` is the watermark: the
// next run detects every product changed at/after the last OK run's watermark.
model DropRun {
  id                String    @id @default(cuid())
  shop              String
  status            String    @default("running") // running | ok | partial | failed
  trigger           String    @default("cron") // cron | manual | webhook
  since             DateTime? // watermark this run covered FROM
  coverageThrough   DateTime? // watermark this run advances TO (its start), set when ok
  productsDetected  Int       @default(0)
  productsEmbedded  Int       @default(0)
  embedFailures     Int       @default(0)
  activeRequests    Int       @default(0)
  evalsAttempted    Int       @default(0)
  evalsCompleted    Int       @default(0)
  evalErrors        Int       @default(0)
  matchesCreated    Int       @default(0)
  queueRemaining    Int       @default(0)
  // Human-readable failure/skip list + notes for the audit report.
  failures          Json?
  note              String?
  startedAt         DateTime  @default(now())
  finishedAt        DateTime?

  @@index([shop, startedAt])
  @@index([shop, status])
}

// Instant-ack webhook queue: products/create|update handlers upsert a row here
// and return 200 immediately (Shopify never times out / retries). A single
// leased drain worker (webhook waitUntil + cron) processes the queue in BATCHED
// AI calls. One row per (shop, product) — a newer event replaces the payload.
model ProductQueue {
  id        String    @id @default(cuid())
  shop      String
  productId String
  payload   Json // shaped product object (title, description, price, image, active…)
  attempts  Int       @default(0)
  status    String    @default("queued") // queued | failed (gave up after MAX_ATTEMPTS)
  claimedAt DateTime? // lease: claims older than 3 min are reclaimable
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@unique([shop, productId])
  @@index([shop, status])
}

// Per-shop mutex so at most ONE drain worker runs at a time (bounded AI
// concurrency). Lease-based: expired `until` means the lock is free.
model DrainLock {
  shop  String   @id
  until DateTime @default(now())
}

// Daily counters for the cost kill switch: "anthropic_calls" hard-stops
// matching past ANTHROPIC_DAILY_CALL_LIMIT; "match_emails" caps outbound
// match-alert emails per day.
model DailyCounter {
  id    String   @id @default(cuid())
  day   DateTime @db.Date
  key   String
  count Int      @default(0)

  @@unique([day, key])
}

model ProductEmbedding {
  id          String   @id @default(cuid())
  shop        String
  productId   String   @unique
  hash        String
  embedding   Json
  // pgvector column, kept in sync from `embedding` by a DB trigger. Queried via
  // $queryRaw for top-K similarity search inside Postgres (see matchRunner).
  vec         Unsupported("vector(1024)")?
  title       String?
  description String?
  productType String?
  price       Float?
  image       String?
  // Available-inventory gate: false when the product's tracked available
  // quantity (summed across locations/variants) is 0 — i.e. SOLD. Sold items
  // stay in the catalog (and keep their embedding for restocks) but are
  // excluded from retrieval and matching, and their matches are removed.
  // Untracked-inventory products count as in stock.
  inStock     Boolean  @default(true)
  updatedAt   DateTime @updatedAt

  @@index([shop])
}

model ShopConfig {
  id              String   @id @default(cuid())
  shop            String   @unique
  // Matches scoring >= autoNotifyScore notify the salesperson directly.
  // Matches scoring >= reviewScore but < autoNotifyScore go to the review queue.
  // Below reviewScore are dropped.
  autoNotifyScore Int      @default(50)
  reviewScore     Int      @default(40)
  // When enabled, borderline (review-band) matches are additionally judged by a
  // single structured LLM call before being queued/notified.
  stage2Enabled   Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model Session {
  id            String    @id
  shop          String
  state         String
  isOnline      Boolean   @default(false)
  scope         String?
  expires       DateTime?
  accessToken   String
  userId        BigInt?
  firstName     String?
  lastName      String?
  email         String?
  accountOwner  Boolean   @default(false)
  locale        String?
  collaborator  Boolean?  @default(false)
  emailVerified Boolean?  @default(false)
  refreshToken        String?
  refreshTokenExpires DateTime?
}
