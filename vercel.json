{
  "buildCommand": "npm run vercel-build",
  "outputDirectory": "build/client",
  "functions": {
    "api/handler.js": {
      "maxDuration": 120,
      "includeFiles": "{build/**,node_modules/.prisma/client/**,node_modules/@prisma/client/**}"
    }
  },
  "rewrites": [
    { "source": "/(.*)", "destination": "/api/handler.js" }
  ],
  "crons": [
    { "path": "/api/digest", "schedule": "0 13 * * *" },
    { "path": "/api/check-products", "schedule": "30 13 * * *" }
  ]
}
